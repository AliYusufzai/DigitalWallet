{
  "Serilog": {
    "Using": [
      "Serilog.Sinks.Console",
      "Serilog.Sinks.Seq"
    ],
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore": "Warning"
      }
    },
    "WriteTo": [
      {
        "Name": "Console"
      },
      {
        "Name": "Seq",
        "Args": {
          "serverUrl": "http://localhost:5341"
        }
      }
    ]
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": "",
    "ExpiryMinutes": 0
  },
  "TransferConfirmation": {
    "ExpirySeconds": 120,
    "MaxAttempts": 3,
    "ResendCooldownSeconds": 60
  },
  "EmailSettings": {
    "Host": "",
    "Port": 0,
    "Username": "",
    "FromEmail": ""
  },
  "EmailVerification": {
    "FrontendUrl": ""
  },
  "WalletLimits": {
    "DailyOutgoingLimit": 100000
  }
}